  "sampling_rules": {
    "freeze_manifest_before_scanning": true,
    "exclude_public_rule_fixtures_when_possible": true,
    "replace_released_failure_labels_after_each_closed_round": true
  },
  "samples": [
    {
      "id": "holdout-sample-001",
