      "category": "coding-agent",
      "language_strata": ["Python"],
      "framework_strata": ["OpenAI Agents SDK"],
      "selected_roots": ["src", "pyproject.toml"],
      "include_dependency_materialized_files": false,
      "excluded_paths": [
        {
          "path": "tests",
          "reason": "negative-control sample is tracked separately"
        }
