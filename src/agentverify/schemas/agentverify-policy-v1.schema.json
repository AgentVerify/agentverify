{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVerify Policy 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "anyOf": [
    {"required": ["extends"]},
    {"required": ["gates"]}
  ],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "extends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "max_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AV-A2A001",
              "AV-APPROVAL001",
              "AV-APPROVAL002",
              "AV-APPROVAL003",
              "AV-APPROVAL004",
              "AV-APPROVAL005",
              "AV-APPROVAL006",
              "AV-APPROVAL007",
              "AV-APPROVAL008",
              "AV-AUDIT001",
              "AV-EXEC001",
              "AV-EXEC002",
              "AV-FS001",
              "AV-FS002",
              "AV-MCP002",
              "AV-MCP003",
              "AV-MCP004",
              "AV-MCP005",
              "AV-MCP006",
              "AV-MCP007",
              "AV-NET001",
              "AV-SANDBOX001"
            ]
          }
        },
        "result_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["finding", "review"]}
        },
        "min_severity": {"enum": ["info", "low", "medium", "high"]},
        "max_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
