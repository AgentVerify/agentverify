{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentverify.dev/schemas/agentverify-editor-diagnostics-v1.schema.json",
  "title": "AgentVerify Editor Diagnostics 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_report", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "source_report": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "passed", "evaluated_after_baseline"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "passed": {"type": "boolean"},
        "evaluated_after_baseline": {"const": true}
      }
    },
    "policy_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/policyGroup"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    }
  },
  "allOf": [
    {
      "if": {"required": ["policy"]},
      "then": {"required": ["policy_groups"]}
    },
    {
      "if": {"required": ["policy_groups"]},
      "then": {"required": ["policy"]}
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "character"],
      "properties": {
        "line": {"type": "integer", "minimum": 0},
        "character": {"type": "integer", "minimum": 0}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "range", "severity", "code", "source", "message", "data"],
      "properties": {
        "uri": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "range": {"$ref": "#/$defs/range"},
        "severity": {"type": "integer", "minimum": 1, "maximum": 4},
        "code": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"const": "agentverify"},
        "message": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "data": {"$ref": "#/$defs/diagnosticData"}
      }
    },
    "diagnosticData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "result_kind", "confidence", "ir_path"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "result_kind": {"enum": ["inventory", "review", "finding"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "ir_path": {"type": "array", "items": {"type": "string"}},
        "policy_gate_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "policy_status": {"enum": ["not_matched", "passed", "failed"]}
      },
      "allOf": [
        {
          "if": {"required": ["policy_gate_ids"]},
          "then": {"required": ["policy_status"]}
        },
        {
          "if": {"required": ["policy_status"]},
          "then": {"required": ["policy_gate_ids"]}
        }
      ]
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "matchedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_rule", "by_result_kind", "by_severity"],
      "properties": {
        "by_rule": {"$ref": "#/$defs/countMap"},
        "by_result_kind": {"$ref": "#/$defs/countMap"},
        "by_severity": {"$ref": "#/$defs/countMap"}
      }
    },
    "policyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "policy_source",
        "passed",
        "matched_count",
        "max_count",
        "min_severity",
        "result_kinds",
        "rules",
        "matched_summary",
        "diagnostic_fingerprints"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "policy_source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "passed": {"type": "boolean"},
        "matched_count": {"type": "integer", "minimum": 0},
        "max_count": {"type": "integer", "minimum": 0},
        "min_severity": {"enum": ["info", "low", "medium", "high"]},
        "result_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["review", "finding"]}
        },
        "rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "matched_summary": {"$ref": "#/$defs/matchedSummary"},
        "diagnostic_fingerprints": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{20}$"}
        }
      }
    }
  }
}
