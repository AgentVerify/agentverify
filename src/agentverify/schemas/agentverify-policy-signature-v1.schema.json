{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVerify Policy Signature 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signature_format", "signed_at", "payload", "signatures"],
  "properties": {
    "schema_version": {"const": 1},
    "signature_format": {"const": "agentverify-policy-signature"},
    "signed_at": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/policySigningPayload"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "policySigningPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_signing_payload_format",
        "schema_version",
        "root_source",
        "root_sha256",
        "policy_set"
      ],
      "properties": {
        "policy_signing_payload_format": {"const": "AgentVerify Policy Signing Payload"},
        "schema_version": {"const": 1},
        "root_source": {"type": "string", "minLength": 1},
        "root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_set": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/policySource"}
        }
      }
    },
    "policySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "signature"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "ed25519"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    }
  }
}
