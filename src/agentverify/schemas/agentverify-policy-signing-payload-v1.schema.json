{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVerify Policy Signing Payload 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_signing_payload_format",
    "schema_version",
    "root_source",
    "root_sha256",
    "policy_set"
  ],
  "properties": {
    "policy_signing_payload_format": {"const": "AgentVerify Policy Signing Payload"},
    "schema_version": {"const": 1},
    "root_source": {"type": "string", "minLength": 1},
    "root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_set": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policySource"}
    }
  },
  "$defs": {
    "policySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
