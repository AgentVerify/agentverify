{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVerify JSON Report 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_format",
    "schema_version",
    "root",
    "scan_scope",
    "path_filters",
    "baseline_summary",
    "policy_summary",
    "files_scanned",
    "config_files_scanned",
    "suppressed_findings",
    "components",
    "relationships",
    "findings",
    "suppressions",
    "errors",
    "risk_summary"
  ],
  "properties": {
    "report_format": {"const": "AgentVerify JSON Report"},
    "schema_version": {"const": 1},
    "root": {"type": "string"},
    "scan_scope": {"enum": ["repository", "selected-paths"]},
    "path_filters": {"type": "array", "items": {"type": "string"}},
    "baseline_summary": {"$ref": "#/$defs/baselineSummary"},
    "policy_summary": {"$ref": "#/$defs/policySummary"},
    "files_scanned": {"type": "integer", "minimum": 0},
    "config_files_scanned": {"type": "integer", "minimum": 0},
    "suppressed_findings": {"type": "integer", "minimum": 0},
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "suppressions": {
      "type": "array",
      "items": {"$ref": "#/$defs/suppression"}
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "risk_summary": {"$ref": "#/$defs/riskSummary"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "excerpt"],
      "properties": {
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "evidence", "attributes", "symbol_id"],
      "properties": {
        "kind": {"type": "string"},
        "name": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "attributes": {"type": "object"},
        "symbol_id": {"type": ["string", "null"]}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_name",
        "relation",
        "target_kind",
        "target_name",
        "evidence",
        "attributes",
        "source_id",
        "target_id"
      ],
      "properties": {
        "source_kind": {"type": "string"},
        "source_name": {"type": "string"},
        "relation": {"type": "string"},
        "target_kind": {"type": "string"},
        "target_name": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "attributes": {"type": "object"},
        "source_id": {"type": ["string", "null"]},
        "target_id": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "severity",
        "confidence",
        "message",
        "evidence",
        "remediation",
        "fingerprint",
        "result_kind",
        "ir_path",
        "analysis"
      ],
      "properties": {
        "rule_id": {"type": "string"},
        "severity": {"enum": ["info", "low", "medium", "high"]},
        "confidence": {"type": "string"},
        "message": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "remediation": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "result_kind": {"enum": ["inventory", "review", "finding"]},
        "ir_path": {"type": "array", "items": {"type": "string"}},
        "analysis": {"type": "object"}
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "reason", "finding", "directive", "expires_on", "status"],
      "properties": {
        "rule_id": {"type": "string"},
        "reason": {"type": "string"},
        "finding": {"$ref": "#/$defs/evidence"},
        "directive": {"$ref": "#/$defs/evidence"},
        "expires_on": {"type": ["string", "null"]},
        "status": {"type": "string"}
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_rule", "by_result_kind", "by_severity"],
      "properties": {
        "by_rule": {"$ref": "#/$defs/countMap"},
        "by_result_kind": {"$ref": "#/$defs/countMap"},
        "by_severity": {"$ref": "#/$defs/countMap"}
      }
    },
    "baselineSummary": {
      "anyOf": [
        {"type": "object", "maxProperties": 0},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_fingerprints",
            "current_fingerprints",
            "new",
            "unchanged",
            "no_longer_reported"
          ],
          "properties": {
            "baseline_fingerprints": {"type": "integer", "minimum": 0},
            "current_fingerprints": {"type": "integer", "minimum": 0},
            "new": {"type": "integer", "minimum": 0},
            "unchanged": {"type": "integer", "minimum": 0},
            "no_longer_reported": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      ]
    },
    "policySummary": {
      "anyOf": [
        {"type": "object", "maxProperties": 0},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "source",
            "sha256",
            "sources",
            "evaluated_after_baseline",
            "passed",
            "gates"
          ],
          "properties": {
            "name": {"type": "string"},
            "source": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/policySource"}
            },
            "evaluated_after_baseline": {"const": true},
            "passed": {"type": "boolean"},
            "gates": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/policyGateSummary"}
            }
          }
        }
      ]
    },
    "policySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256"],
      "properties": {
        "source": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policyGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rules",
        "result_kinds",
        "min_severity",
        "max_count",
        "policy_source",
        "policy_sha256",
        "matched_count",
        "matched_summary",
        "matched_fingerprints",
        "passed"
      ],
      "properties": {
        "id": {"type": "string"},
        "rules": {"type": "array", "items": {"type": "string"}},
        "result_kinds": {
          "type": "array",
          "items": {"enum": ["finding", "review"]}
        },
        "min_severity": {"enum": ["info", "low", "medium", "high"]},
        "max_count": {"type": "integer", "minimum": 0},
        "policy_source": {"type": "string"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matched_count": {"type": "integer", "minimum": 0},
        "matched_summary": {"$ref": "#/$defs/riskSummary"},
        "matched_fingerprints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{20}$"}
        },
        "passed": {"type": "boolean"}
      }
    }
  }
}
