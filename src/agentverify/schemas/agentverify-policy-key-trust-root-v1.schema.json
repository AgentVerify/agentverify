{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVerify Policy Key Trust Root 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_model", "keys"],
  "properties": {
    "schema_version": {"const": 1},
    "trust_model": {"const": "local-key-signature"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/trustedKey"}
    }
  },
  "$defs": {
    "trustedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "public_key",
        "trusted_for",
        "not_before",
        "not_after"
      ],
      "properties": {
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"const": "ed25519"},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "trusted_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "policy-signing"},
          "items": {"enum": ["policy-signing"]}
        },
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"}
      }
    }
  }
}
