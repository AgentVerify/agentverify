{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVerify Policy Trust Root 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_model", "policies"],
  "properties": {
    "schema_version": {"const": 1},
    "trust_model": {"const": "local-content-digest-allowlist"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policyDigest"}
    }
  },
  "$defs": {
    "policyDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
