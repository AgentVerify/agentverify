{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentverify.dev/schemas/agentverify-benchmark-verification-v1.schema.json",
  "title": "AgentVerify Benchmark Verification 1",
  "type": "object",
  "required": ["results", "passed", "all_labels_passed"],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "result",
          "evaluation_kind",
          "label_scope",
          "sealed",
          "labels",
          "passed",
          "labels_source",
          "claim_scope",
          "digest_ok"
        ],
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "string",
            "minLength": 1
          },
          "evaluation_kind": {
            "enum": ["public-regression", "sealed-holdout"]
          },
          "label_scope": {
            "enum": ["reporting-rules", "agent-ir", "mixed"]
          },
          "sealed": {
            "type": "boolean"
          },
          "labels": {
            "type": "integer",
            "minimum": 0
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "labels_source": {
            "type": "string",
            "minLength": 1
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "digest_ok": {
            "type": "boolean"
          }
        }
      }
    },
    "passed": {
      "type": "boolean"
    },
    "all_labels_passed": {
      "type": "boolean"
    }
  }
}
